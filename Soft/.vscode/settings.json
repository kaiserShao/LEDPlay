{
    // =========================================================================
    //  灯带消消乐 —— VSCode 工作区设置
    //
    //  作用: 编辑 .c/.h 时"保存即格式化"(Allman 大括号 + 末尾留一个换行),
    //        规则见工程根目录的 .clang-format。
    //
    //  注意: 本工程用 Keil MDK 编译, VSCode 只负责编辑。格式化不会改变语义,
    //        但会让代码在 Keil 里看起来更整齐。不想要自动格式化时, 把下面
    //        "editor.formatOnSave" 改成 false 即可。
    // =========================================================================
    "editor.formatOnSave": true,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false,
    // 大文件/长行格式化超时放宽(默认 750ms 有时不够)
    "editor.formatOnSaveTimeout": 5000,

    // ------------------------- C / C++ 格式化 -------------------------------
    // 使用本工程根目录的 .clang-format
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.clang_format_fallbackStyle": "file",
    // 指定 clang-format 可执行文件: 这样版本可控(支持 InsertNewlineAtEOF)。
    // 若以后升级/卸载了 C/C++ 扩展导致此路径失效, 直接删掉这一行即可,
    // 扩展会自动使用它内置的 clang-format。
    "C_Cpp.clang_format_path": "C:\\Users\\Kaiser\\.vscode\\extensions\\ms-vscode.cpptools-1.34.4-win32-x64\\LLVM\\bin\\clang-format.exe",
    "C_Cpp.vcFormat.indent.braces": true,
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.default.cStandard": "c99",
    "C_Cpp.default.intelliSenseMode": "gcc-arm",

    // ------------------------- 保存时的文件卫生 -----------------------------
    // 与 .clang-format 的 InsertNewlineAtEOF 呼应: 文件末尾保留一个换行符
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": false,
    "files.trimTrailingWhitespace": false,
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,
    "files.eol": "\r\n",

    // ------------------------- 本工程的语言级设置 ---------------------------
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.rulers": [
            120
        ]
    },
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
    },
    "[json]": {
        "editor.tabSize": 4
    },

    // ------------------------- 搜索/浏览排除编译产物 -------------------------
    "files.exclude": {
        "**/Objects": true,
        "**/Listings": true,
        "**/*.uvguix.*": true
    },
    "search.exclude": {
        "**/Objects": true,
        "**/Listings": true,
        "**/RTE": true,
        "**/Temp": true
    },
    "files.associations": {
        "*.h": "c",
        "*.uvprojx": "xml"
    }
}
